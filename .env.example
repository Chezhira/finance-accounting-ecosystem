# FinOps Ecosystem — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Anthropic API ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── Accounting System ──────────────────────────────────────────────────────
# Options: "mock" (development) | "quickbooks" (production)
ACCOUNTING_SYSTEM=mock

# QuickBooks (only needed if ACCOUNTING_SYSTEM=quickbooks)
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ACCESS_TOKEN=
# QUICKBOOKS_REALM_ID=

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (offline) — auto-created, no config needed
# Postgres (online sync) — fill in when you have a Postgres server
# POSTGRES_URL=postgresql://user:password@localhost:5432/finops

# ── Email Notifications ────────────────────────────────────────────────────
# Leave SMTP_USER empty to disable email (logs to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=finops@yourdomain.com
OPERATOR_EMAIL=operator@yourdomain.com

# ── Auto-Post on Approval ──────────────────────────────────────────────────
# true  = automatically post to accounting system when human approves
# false = human must manually post after approving
AUTO_POST_ON_APPROVAL=true

# ── Market Data ────────────────────────────────────────────────────────────
# true  = live FX rates (ExchangeRate-API) + FRED US rates
# false = mock rates (no API calls)
MARKET_DATA_LIVE=true

# ── RBAC (Role-Based Access Control) ───────────────────────────────────────
# Set RBAC_ENABLED=true to enforce API key authentication on all routes.
# When false (default), all requests are treated as admin — no key required.
#
# Roles and permissions:
#   viewer  → read-only access to suggestion queue and stats
#   analyst → queue + ingest + FP&A, audit, treasury, corp finance, accounting
#   senior  → analyst permissions + escalation management
#   admin   → full access to all routes including tax, market data, tenants
#
# Generate a secure random key for each role, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leave a key blank to disable that role.
RBAC_ENABLED=false
RBAC_KEY_VIEWER=
RBAC_KEY_ANALYST=
RBAC_KEY_SENIOR=
RBAC_KEY_ADMIN=

# To enable RBAC:
# 1. Set RBAC_ENABLED=true
# 2. Generate a secure key for each role you want to use
# 3. Distribute keys to users — they pass it as the X-Api-Key header
# 4. Test with: curl -H "X-Api-Key: your-key" http://localhost:8000/auth/role

# ── Tax Supervisor ─────────────────────────────────────────────────────────
# true  = tax analyses pass through TaxSupervisor review before escalation
# false = tax analyses go directly to escalation chain (faster, less thorough)
TAX_SUPERVISOR_ENABLED=true

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
