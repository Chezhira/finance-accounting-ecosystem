# FinOps Ecosystem — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Anthropic API ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── Active Tenant ──────────────────────────────────────────────────────────
# Default tenant used when none is specified in API calls
# Options: mersi_us | chezsolutions_tz | family_llc_us
DEFAULT_TENANT_ID=mersi_us

# ── Accounting System ──────────────────────────────────────────────────────
# Options: "mock" (development/trial) | "quickbooks" (production)
ACCOUNTING_SYSTEM=mock

# ── QuickBooks Online — Mersi Distribution ─────────────────────────────────
# Obtain from: Intuit Developer Portal → your app → Keys & OAuth
# Access token expires every 60 days — refresh via OAuth flow
# Realm ID = Company ID (found in QBO URL: /app/homepage?&companyId=XXXXXXX)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ACCESS_TOKEN=
QB_REFRESH_TOKEN=
QB_REALM_ID=
QB_SANDBOX=false

# ── Bill.com — Mersi AP Payments ───────────────────────────────────────────
# Used for AP payment visibility (read) and future payment scheduling
# BILLCOM_USERNAME=
# BILLCOM_PASSWORD=
# BILLCOM_ORG_ID=
# BILLCOM_DEV_KEY=

# ── SouthStar Factoring — Mersi AR ─────────────────────────────────────────
# No direct API — data ingested via weekly spreadsheet upload
# Tuesday submission cycle | 80% advance rate | 2% fee
# Upload via: POST /ingest/upload (tenant_id=mersi_us)

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (offline) — auto-created, no config needed
# Postgres (online sync) — fill in when you have a Postgres server
# POSTGRES_URL=postgresql://user:password@localhost:5432/finops

# ── Weekly Finance Health Report ──────────────────────────────────────────
# Runs every Friday 7 AM EAT. Zahidah reviews → forwards to Faris when ready.
# Switch REPORT_MODE=live once QBO + Fishbowl credentials are filled in above.
#
# Gmail setup: enable 2FA → Google Account → Security → App Passwords
# Create an App Password (type: Mail) and paste as REPORT_SMTP_PASSWORD.
# NEVER use your normal Gmail login password here.
#
REPORT_MODE=mock                         # mock | live  (switches data source)
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=                        # your Gmail: ziddmurira@gmail.com
REPORT_SMTP_PASSWORD=                    # Gmail App Password (16-char code)
REPORT_FROM_EMAIL=                       # same as REPORT_SMTP_USER
REPORT_FROM_NAME=Zahidah Murira
REPORT_TO_EMAIL=ziddmurira@gmail.com     # goes to Zahidah first for review
REPORT_CC_EMAIL=                         # add Faris's email here when ready to loop him in

# ── Email Notifications (ecosystem alerts) ─────────────────────────────────
# Leave SMTP_USER empty to disable email (logs to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=finops@yourdomain.com
OPERATOR_EMAIL=operator@yourdomain.com

# ── Auto-Post on Approval ──────────────────────────────────────────────────
# true  = automatically post to accounting system when human approves
# false = human must manually post after approving
AUTO_POST_ON_APPROVAL=true

# ── Market Data ────────────────────────────────────────────────────────────
# true  = live FX rates (ExchangeRate-API) + FRED US rates
# false = mock rates (no API calls)
MARKET_DATA_LIVE=true

# ── RBAC (Role-Based Access Control) ───────────────────────────────────────
# Set RBAC_ENABLED=true to enforce API key authentication on all routes.
# When false (default), all requests are treated as admin — no key required.
#
# Roles and permissions:
#   viewer  → read-only access to suggestion queue and stats
#   analyst → queue + ingest + FP&A, audit, treasury, corp finance, accounting
#   senior  → analyst permissions + escalation management
#   admin   → full access to all routes including tax, market data, tenants
#
# Generate a secure random key for each role, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leave a key blank to disable that role.
RBAC_ENABLED=false
RBAC_KEY_VIEWER=
RBAC_KEY_ANALYST=
RBAC_KEY_SENIOR=
RBAC_KEY_ADMIN=

# To enable RBAC:
# 1. Set RBAC_ENABLED=true
# 2. Generate a secure key for each role you want to use
# 3. Distribute keys to users — they pass it as the X-Api-Key header
# 4. Test with: curl -H "X-Api-Key: your-key" http://localhost:8000/auth/role

# ── Tax Supervisor ─────────────────────────────────────────────────────────
# true  = tax analyses pass through TaxSupervisor review before escalation
# false = tax analyses go directly to escalation chain (faster, less thorough)
TAX_SUPERVISOR_ENABLED=true

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
